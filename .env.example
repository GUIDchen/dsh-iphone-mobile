# 复制为 .env 后填写，真实值不要入库

# dsh web 上游（保持本机监听）
DSH_PORT=3080

# 网关监听。经隧道暴露时用 0.0.0.0，仅本机调试保持 127.0.0.1
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3081
# 留空则自动生成到 ~/.dsh-mobile/token
GATEWAY_TOKEN=

# Web Push（npx web-push generate-vapid-keys 生成）
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# APNs（可选，需要付费开发者账号）
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_P8_PATH=
